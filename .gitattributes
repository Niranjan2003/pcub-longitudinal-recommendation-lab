# Default: store text with LF line endings and check it out with LF.
* text=auto eol=lf

# Backend: byte-exact, no line-ending conversion of any kind.
# implementation_ledger.json, assets/subset_manifest.json, the golden capture
# manifest and the model-package manifests record SHA-256 hashes of raw bytes,
# and the server re-verifies every asset hash at start-up. Several of these
# files have CRLF line endings, others LF; converting either breaks the checks.
backend/** -text

# Binary assets
*.parquet binary
*.sqlite3 binary
*.png     binary
*.jpg     binary
*.ico     binary
*.woff    binary
*.woff2   binary
