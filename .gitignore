# --- Python -----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Backend runtime state (never commit) ------------------------------------
# SQLite session/job stores, provider journals and writer locks are created by
# the running server under backend/runtime/. They are local, mutable and may
# contain provider responses.
backend/runtime/
runtime/
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.db
*.writer.lock

# --- Node / frontend build and test output -----------------------------------
node_modules/
dist/
coverage/
playwright-report/
test-results/
blob-report/
.vite/
.eslintcache
*.tsbuildinfo
*.log

# --- Secrets and local environment -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- Local development-tool settings -----------------------------------------
# Hidden editor and tool directories, hidden tool configuration files and
# machine-local settings or notes stay out of the repository.
.*/
!.github/
.*.json
*.local.*

# --- Operating system --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
